exports[`renderRecipeText > draws banana-bread.json 1`] = `
"Banana Bread
1 loaf (9×5 in) · 1 h 15 min

Prep: Preheat the oven, 175 °C
Prep: Grease a 9×5 in loaf pan

+--------------------------------+--------------+---------------+---------+---------+-------------------+------------------------------------------+
| 115 g / ½ cup butter, softened | cream, 3 min |               |         |         |                   |                                          |
+--------------------------------+              |               |         |         |                   |                                          |
| 200 g / 1 cup sugar            |              | beat in       |         |         |                   |                                          |
+--------------------------------+--------------+               |         |         |                   |                                          |
| 2 eggs                                        |               | combine |         |                   |                                          |
+--------------------------------+--------------+---------------+         |         |                   |                                          |
| 3 ripe bananas                 | mash         | stir together |         |         |                   |                                          |
+--------------------------------+--------------+               |         |         |                   |                                          |
| 1 tsp vanilla extract                         |               |         | fold in | bake, 1 h, 175 °C | cool, 15 min, in the pan, then on a rack |
+--------------------------------+--------------+---------------+---------+         |                   |                                          |
| 250 g / 2 cups flour           |                                        |         |                   |                                          |
+--------------------------------+                                        |         |                   |                                          |
| 1 tsp baking soda              | whisk                                  |         |                   |                                          |
+--------------------------------+                                        |         |                   |                                          |
| ½ tsp salt                     |                                        |         |                   |                                          |
+--------------------------------+----------------------------------------+         |                   |                                          |
| 60 g walnuts, chopped (optional)                                        |         |                   |                                          |
+-------------------------------------------------------------------------+---------+-------------------+------------------------------------------+"
`;

exports[`renderRecipeText > draws mapo-tofu.json 1`] = `
"Mapo Tofu
4 servings · 30 min

Prep: Bring a pot of water to a gentle simmer

+--------------------------------+-----------------------------+------------------------------------+------------------------------+---------------------------------------+----------+
| 2 tbsp neutral oil             | stir-fry until crisp, 4 min |                                    |                              |                                       |          |
+--------------------------------+                             |                                    |                              |                                       |          |
| 150 g ground pork              |                             |                                    |                              |                                       |          |
+--------------------------------+-----------------------------+                                    |                              |                                       |          |
| 2 tbsp Pixian doubanjiang, chopped                           |                                    |                              |                                       |          |
+--------------------------------------------------------------+                                    |                              |                                       |          |
| 1 tbsp fermented black beans, rinsed                         | fry until the oil turns red, 1 min |                              |                                       |          |
+--------------------------------------------------------------+                                    |                              |                                       |          |
| 3 cloves garlic, minced                                      |                                    |                              |                                       |          |
+--------------------------------------------------------------+                                    |                              |                                       |          |
| 1 tbsp ginger, minced                                        |                                    | add and simmer gently, 5 min |                                       |          |
+--------------------------------------------------------------+                                    |                              |                                       |          |
| 1–2 tsp chili flakes                                         |                                    |                              | stir in, in 3 additions, until glossy |          |
+--------------------------------------------------------------+------------------------------------+                              |                                       |          |
| 250 ml chicken stock                                                                              |                              |                                       | top with |
+---------------------------------------------------------------------------------------------------+                              |                                       |          |
| 1 tsp light soy sauce                                                                             |                              |                                       |          |
+---------------------------------------------------------------------------------------------------+                              |                                       |          |
| 1 tsp sugar                                                                                       |                              |                                       |          |
+--------------------------------+------------------------------------------------------------------+                              |                                       |          |
| 400 g soft tofu, in 2 cm cubes | blanch, 1 min, then drain                                        |                              |                                       |          |
+--------------------------------+                                                                  |                              |                                       |          |
| 1 tsp salt, for the water      |                                                                  |                              |                                       |          |
+--------------------------------+------------------------------------------------------------------+------------------------------+                                       |          |
| 1 tbsp cornstarch              | stir together                                                                                   |                                       |          |
+--------------------------------+                                                                                                 |                                       |          |
| 3 tbsp cold water              |                                                                                                 |                                       |          |
+--------------------------------+-------------------------------------------------------------------------------------------------+---------------------------------------+          |
| 1 tsp Sichuan peppercorns, toasted and ground                                                                                                                            |          |
+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------+          |
| 2 scallions, sliced                                                                                                                                                      |          |
+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------+----------+"
`;

exports[`renderRecipeText > draws pancakes.json 1`] = `
"Pancakes
4 servings · 30 min

+-----------------------+-------+-------------------------------------+-----------------------------------------+
| 2 cups / 250 g flour  |       |                                     |                                         |
+-----------------------+       |                                     |                                         |
| 2 tbsp sugar          | whisk |                                     |                                         |
+-----------------------+       |                                     |                                         |
| 2 tsp baking powder   |       |                                     |                                         |
+-----------------------+       |                                     |                                         |
| ½ tsp salt            |       | fold together, a few lumps are fine | cook, 2 min, per side, on a hot griddle |
+-----------------------+-------+                                     |                                         |
| 2 eggs                |       |                                     |                                         |
+-----------------------+       |                                     |                                         |
| 1½ cups / 360 ml milk | whisk |                                     |                                         |
+-----------------------+       |                                     |                                         |
| 3 tbsp butter, melted |       |                                     |                                         |
+-----------------------+-------+-------------------------------------+-----------------------------------------+"
`;

exports[`renderRecipeText > draws vegetarian-luroufan.json 1`] = `
"Vegetarian Luroufan
4 servings · 1 h 30 min

+----------------------------+-------------------------+----------------+----------------------------------+-------------------------------+-----------------------------------------------------------------------------------+----------------------------+
| 3 tbsp neutral oil         | fry until golden, 5 min |                |                                  |                               |                                                                                   |                            |
+----------------------------+                         |                |                                  |                               |                                                                                   |                            |
| 6 shallots, thinly sliced  |                         | stir in, 1 min | fry until lightly browned, 6 min |                               |                                                                                   |                            |
+----------------------------+-------------------------+                |                                  |                               |                                                                                   |                            |
| 4 cloves garlic, minced                              |                |                                  |                               |                                                                                   |                            |
+------------------------------------------------------+----------------+                                  |                               |                                                                                   |                            |
| 400 g firm tofu, pressed, finely diced                                |                                  | add with their water, deglaze |                                                                                   |                            |
+----------------------------+------------------------------------------+----------------------------------+                               |                                                                                   |                            |
| 8 dried shiitake mushrooms | soak, then dice, 30 min, keep the soaking water                             |                               |                                                                                   |                            |
+----------------------------+                                                                             |                               |                                                                                   |                            |
| 500 ml warm water          |                                                                             |                               |                                                                                   |                            |
+----------------------------+-----------------------------------------------------------------------------+                               |                                                                                   |                            |
| 2 tbsp Shaoxing wine                                                                                     |                               | braise, covered, on low heat, 40 min, stir now and then; add water if it gets dry |                            |
+----------------------------------------------------------------------------------------------------------+-------------------------------+                                                                                   |                            |
| 3 tbsp light soy sauce                                                                                                                   |                                                                                   | spoon over, halve the eggs |
+------------------------------------------------------------------------------------------------------------------------------------------+                                                                                   |                            |
| 1 tbsp dark soy sauce                                                                                                                    |                                                                                   |                            |
+------------------------------------------------------------------------------------------------------------------------------------------+                                                                                   |                            |
| 20 g rock sugar                                                                                                                          |                                                                                   |                            |
+------------------------------------------------------------------------------------------------------------------------------------------+                                                                                   |                            |
| ½ tsp five-spice powder                                                                                                                  |                                                                                   |                            |
+------------------------------------------------------------------------------------------------------------------------------------------+                                                                                   |                            |
| ¼ tsp ground white pepper                                                                                                                |                                                                                   |                            |
+------------------------------------------------------------------------------------------------------------------------------------------+                                                                                   |                            |
| 4 eggs, hard-boiled and peeled (optional)                                                                                                |                                                                                   |                            |
+------------------------------------------------------------------------------------------------------------------------------------------+-----------------------------------------------------------------------------------+                            |
| 4 cups jasmine rice, cooked, hot                                                                                                                                                                                             |                            |
+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+                            |
| pickled radish or cucumber, to serve (optional)                                                                                                                                                                              |                            |
+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+----------------------------+"
`;
