{
  "schemaVersion": 1,
  "title": "Banana Bread",
  "yield": { "amount": 1, "unit": "loaf (9×5 in)" },
  "time": { "total": "PT1H15M" },
  "prep": [
    { "id": "preheat", "action": "Preheat the oven", "temperature": { "value": 175, "unit": "C" } },
