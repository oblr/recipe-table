  ],
  "ingredients": [
    { "id": "butter", "name": "butter", "quantity": { "value": 115, "unit": "g", "alt": [{ "value": 0.5, "unit": "cup" }] }, "note": "softened" },
    { "id": "sugar", "name": "sugar", "quantity": { "value": 200, "unit": "g", "alt": [{ "value": 1, "unit": "cup" }] } },
    { "id": "eggs", "name": "eggs", "quantity": { "value": 2 } },
    { "id": "bananas", "name": "ripe bananas", "quantity": { "value": 3 } },
    { "id": "vanilla", "name": "vanilla extract", "quantity": { "value": 1, "unit": "tsp" } },
    { "id": "flour", "name": "flour", "quantity": { "value": 250, "unit": "g", "alt": [{ "value": 2, "unit": "cup" }] } },
    { "id": "baking-soda", "name": "baking soda", "quantity": { "value": 1, "unit": "tsp" } },
