{
  "$comment": "Public styling API of recipe-table. Renaming any token or part class is a breaking change. Set tokens on any ancestor of the component, or via its style/className props.",
  "tokens": [
    { "name": "--rt-font-family", "purpose": "All text", "default": "inherit" },
    { "name": "--rt-font-size", "purpose": "Base size; everything else scales from it", "default": "1rem" },
    { "name": "--rt-title-size", "purpose": "Recipe title", "default": "1.5em" },
    { "name": "--rt-color-ink", "purpose": "Text", "default": "#1f1d1a", "defaultDark": "#ece8e1" },
    { "name": "--rt-color-muted", "purpose": "Notes, meta line, source", "default": "#6b665e", "defaultDark": "#a59f95" },
    { "name": "--rt-color-border", "purpose": "Cell borders and frame", "default": "#e3ded5", "defaultDark": "#3a3631" },
    { "name": "--rt-color-surface", "purpose": "Table background", "default": "#ffffff", "defaultDark": "#1c1a18" },
    { "name": "--rt-color-ingredient-bg", "purpose": "Ingredient cells", "default": "transparent" },
    { "name": "--rt-color-step-bg", "purpose": "Step cells at depth 1; deeper steps mix toward --rt-color-root-bg", "default": "#f6f4ef", "defaultDark": "#26231f" },
    { "name": "--rt-color-root-bg", "purpose": "Final step (the finished dish)", "default": "#e8e1d3", "defaultDark": "#3d362b" },
    { "name": "--rt-color-accent", "purpose": "Step times and temperatures, links", "default": "#a2581f", "defaultDark": "#e0955a" },
    { "name": "--rt-border-width", "purpose": "Grid lines", "default": "1px" },
    { "name": "--rt-radius", "purpose": "Outer corners and prep bars", "default": "10px" },
    { "name": "--rt-cell-padding", "purpose": "Cell padding", "default": "0.55rem 0.8rem" },
    { "name": "--rt-quantity-weight", "purpose": "Quantity emphasis", "default": "600" }
  ],
  "parts": [
    { "class": "rt-root", "element": "section", "attributes": ["data-view=auto|table|list"], "note": "Also carries rt-error when the recipe is invalid" },
    { "class": "rt-header", "element": "header" },
    { "class": "rt-title", "element": "h2 (headingLevel prop)" },
    { "class": "rt-meta", "element": "p", "note": "Yield and total time" },
    { "class": "rt-description", "element": "p" },
    { "class": "rt-prep", "element": "ul", "note": "Ingredient-less steps above the table" },
    { "class": "rt-scroll", "element": "div", "note": "Frame and horizontal scroll around the table" },
    { "class": "rt-table", "element": "table" },
    { "class": "rt-row", "element": "tr" },
    { "class": "rt-ingredient", "element": "th[scope=row]", "attributes": ["data-optional"] },
    { "class": "rt-quantity", "element": "span" },
    { "class": "rt-name", "element": "span" },
    { "class": "rt-note", "element": "span" },
    { "class": "rt-step", "element": "td", "attributes": ["data-depth=1..n", "data-root"], "note": "The final step also has class rt-step-root" },
    { "class": "rt-action", "element": "span" },
    { "class": "rt-step-meta", "element": "span", "note": "Duration and temperature" },
    { "class": "rt-list", "element": "ol", "note": "Steps in cooking order; visually hidden in table view, shown in list view" },
    { "class": "rt-source", "element": "p" },
    { "class": "rt-error", "element": "p (inside .rt-root.rt-error)" }
  ]
}
