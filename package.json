{
  "name": "recipe-table",
  "version": "0.1.0",
  "description": "Render recipes as tabular recipes (ingredients are rows, steps are columns) in React. Plain-CSS theming, JSON Schema, agent-friendly.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oblr/recipe-table.git"
  },
  "homepage": "https://github.com/oblr/recipe-table#readme",
  "bugs": {
    "url": "https://github.com/oblr/recipe-table/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./schema.json": "./recipe.schema.json",
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json",
    "./custom-elements.json": "./custom-elements.json"
  },
  "bin": {
    "recipe-table": "dist/cli.js"
  },
  "files": [
    "dist",
    "styles.css",
    "recipe.schema.json",
    "tokens.json",
    "custom-elements.json",
    "examples",
    "AGENTS.md",
    "llms.txt",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "node dist/cli.js preview",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "recipe",
    "cooking",
    "react",
    "web-component",
    "table",
    "tabular-recipe",
    "cooking-for-engineers"
  ],
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
